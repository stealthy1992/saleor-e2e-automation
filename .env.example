SALEOR_API_URL=http://localhost:8000
SALEOR_DASHBOARD_URL=http://localhost:9000

ADMIN_EMAIL=admin@saleor.com
ADMIN_PASSWORD=<set after createsuperuser>

# No remap locally — standard Postgres port, not the VPS's 5433 workaround
DATABASE_URL=postgres://saleor:saleor@127.0.0.1:5432/saleor
# Option A assistant
ASSISTANT_PORT=3100
ASSISTANT_URL=http://localhost:3100
SALEOR_CHANNEL=channel-pkr
POLICY_SLUG=store-policy
SALEOR_APP_TOKEN=<token of the support-assistant app, shown once in the Dashboard>
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=<your key, keep it out of git>
OLLAMA_URL=http://localhost:11434
STUB_LATENCY_MS=0
