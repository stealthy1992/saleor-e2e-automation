SALEOR_API_URL=https://saleor.solception.com
SALEOR_DASHBOARD_URL=https://saleor-dashboard.solception.com

# Staff credentials for authenticated GraphQL mutations (tokenCreate flow)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# For direct Postgres ground-truth assertions (matches the Medusa pattern).
# Container's Postgres is remapped to host port 5433 — see /opt/saleor/docker-compose.yml
DATABASE_URL=postgres://saleor:saleor@127.0.0.1:5433/saleor
